# Solana RPC Endpoints
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_FALLBACK=https://rpc.ankr.com/solana
NEXT_PUBLIC_SOLANA_RPC_BACKUP=https://solana.public-rpc.com

# Jupiter API
NEXT_PUBLIC_JUPITER_API=https://quote-api.jup.ag/v6
NEXT_PUBLIC_JUPITER_SWAP_API=https://quote-api.jup.ag/v6/swap

# Token Lists
NEXT_PUBLIC_TOKEN_LIST=https://token.jup.ag/all
NEXT_PUBLIC_RAYDIUM_API=https://api.raydium.io/v2/sdk/liquidity/mainnet.json
NEXT_PUBLIC_ORCA_API=https://api.orca.so/allPools

# Wallet
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=public_default_project_id

# Fee Configuration
# Set NEXT_PUBLIC_FEE_RESERVE to a valid base58 Solana SPL token account to enable platform fees.
# Leave empty (the default) to disable fee routing and prevent swap failures.
NEXT_PUBLIC_FEE_RESERVE=
NEXT_PUBLIC_DEFAULT_FEE_BPS=20

# Admin panel — comma-separated Solana wallet addresses allowed to access the admin panel.
# Leave empty to disable the allowlist (all wallets permitted).
# When set, requests must include signed ed25519 headers: x-wallet-address, x-wallet-signature,
# x-wallet-message (JSON: {"timestamp":<unix-ms>,"domain":"<host>"})
ADMIN_ALLOWED_WALLETS=
